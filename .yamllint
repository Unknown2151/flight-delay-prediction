---
extends: default

rules:
  line-length:
    max: 120
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed: ['true', 'false', '"true"', 'secrets']
  key-duplicates: enable
  new-line-at-end-of-file: disable

# GitHub Actions workflows use special context syntax that yamllint doesn't understand
# This is a known limitation - the workflows will work fine in GitHub Actions
ignore: |
  .github/workflows/
